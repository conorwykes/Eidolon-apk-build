{
  "name": "Gates of Azura",
  "short_name": "Azura",
  "description": "An original portrait squad RPG with a 15-stage campaign, concurrent Spark combat, evolutions, summons, town building, trials, and offline Android installation.",
  "id": "/",
  "start_url": "/?source=android-app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#061117",
  "theme_color": "#061117",
  "categories": ["games", "role-playing"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    { "name": "Continue story", "short_name": "Quest", "url": "/?open=quests", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Unit archive", "short_name": "Units", "url": "/?open=units", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
